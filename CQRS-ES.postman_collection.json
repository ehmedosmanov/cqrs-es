{
  "info": {
    "name": "CQRS and ES",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "ORD-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "Commands (Write Side)",
      "item": [
        {
          "name": "1. Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has orderId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('orderId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerName\": \"Ahmad Osmanov\",\n  \"items\": [\n    {\n      \"product\": \"MacBook Pro\",\n      \"quantity\": 1,\n      \"price\": 2499\n    },\n    {\n      \"product\": \"Magic Mouse\",\n      \"quantity\": 1,\n      \"price\": 99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "2. Confirm Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Order confirmed\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Order confirmed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "confirm"]
            }
          }
        },
        {
          "name": "3. Ship Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Order shipped\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Order shipped');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"DHL-123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/ship",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "ship"]
            }
          }
        }
      ]
    },
    {
      "name": "Queries (Read Side)",
      "item": [
        {
          "name": "Get Order by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Order has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('orderId');",
                  "    pm.expect(jsonData).to.have.property('customerName');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData).to.have.property('totalAmount');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Orders by Status - PENDING",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Get Orders by Status - CONFIRMED",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "CONFIRMED"
                }
              ]
            }
          }
        },
        {
          "name": "Get Orders by Status - SHIPPED",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?status=SHIPPED",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "SHIPPED"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Event Sourcing",
      "item": [
        {
          "name": "Get Order History (All Events)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Has events array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('events');",
                  "    pm.expect(jsonData.events).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Confirm Already Confirmed Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Has error message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "confirm"]
            }
          }
        },
        {
          "name": "Get Non-Existent Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/FAKE-ORDER",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "FAKE-ORDER"]
            }
          }
        }
      ]
    },
    {
      "name": "Demo Scenario",
      "item": [
        {
          "name": "Demo - 1. Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"DEMO-001\",\n  \"customerName\": \"Ahmad Osmanov\",\n  \"items\": [\n    {\n      \"product\": \"iPhone 15 Pro\",\n      \"quantity\": 1,\n      \"price\": 1199\n    },\n    {\n      \"product\": \"AirPods Pro\",\n      \"quantity\": 1,\n      \"price\": 249\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Demo - 2. Check Order (PENDING)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/DEMO-001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "DEMO-001"]
            }
          }
        },
        {
          "name": "Demo - 3. Confirm Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/DEMO-001/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "DEMO-001", "confirm"]
            }
          }
        },
        {
          "name": "Demo - 4. Check Order (CONFIRMED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/DEMO-001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "DEMO-001"]
            }
          }
        },
        {
          "name": "Demo - 5. Ship Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"UPS-987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/DEMO-001/ship",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "DEMO-001", "ship"]
            }
          }
        },
        {
          "name": "Demo - 6. Check Order (SHIPPED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/DEMO-001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "DEMO-001"]
            }
          }
        },
        {
          "name": "Demo - 7. View Complete History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/DEMO-001/history",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "DEMO-001", "history"]
            }
          }
        }
      ]
    }
  ]
}
